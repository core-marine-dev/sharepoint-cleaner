# SharePoint app-only authentication (Microsoft Entra ID + client certificate)
#
# The legacy ACS model (CLIENT_ID + CLIENT_SECRET) was retired by Microsoft
# on 2 April 2026 and no longer works. You now need an Entra ID App
# Registration with the SharePoint application permission Sites.FullControl.All
# (admin consent granted) and a client certificate.

# Directory (tenant) ID or domain, e.g. company.onmicrosoft.com
TENANT_ID=your-tenant-id-here

# Application (client) ID from the Entra ID App Registration
CLIENT_ID=your-client-id-here

# Certificate thumbprint (as shown in the App Registration > Certificates)
CERT_THUMBPRINT=your-cert-thumbprint-here

# Path to the certificate PRIVATE key (.pem), as seen inside the container
CERT_PATH=/usr/src/app/cert.pem

# Note: SHAREPOINT_SITE_URL is no longer needed.
# The site URL is automatically extracted from the SharePoint URL you paste in the app.
